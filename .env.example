# Copy to .env (gitignored). Compose loads it into the api container automatically.

# eBay Developer credentials (https://developer.ebay.com — founder has an account)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox | production
EBAY_ENV=sandbox
# Marketplace for Browse API searches (US/USD only for MVP)
EBAY_MARKETPLACE_ID=EBAY_US
# Flat final-value fee rate applied to the estimated value (~13.25% typical media rate)
EBAY_FEE_RATE=0.1325
# Hard daily stop for outbound eBay API calls (50% of the 5,000/day app quota)
EBAY_DAILY_CALL_BUDGET=2500

# Vision LLM for photo item identification (post-barcode phase)
ANTHROPIC_API_KEY=

# Flip/rip cutoff in USD when the user hasn't set one
PROFIT_THRESHOLD_DEFAULT=10

# --- Liquidity gate (spec 002) ---
# Active-listing count at or below which supply reads as fully liquid. Also the
# constant behind the 0-1 supply-side liquidity score, so the two never disagree.
LIQUIDITY_STRONG_MAX_LISTINGS=10
# Upper bound of the "moderate" band; above this an item is "weak" (flooded market)
# and the gate can downgrade an otherwise-profitable verdict.
LIQUIDITY_MODERATE_MAX_LISTINGS=50
# How far above the user's profit threshold counts as "comfortable" for a weak-liquidity
# item: >= threshold x this -> FLIP_RISKY (worth a slow sale), below it -> RIP.
# Dimensionless ratio, like EBAY_FEE_RATE.
LIQUIDITY_RISKY_MARGIN_MULTIPLIER=2

# --- Valuation correction (spec 003) ---
# Fraction of the asking-price median an item is expected to actually sell for.
# Valid range: 0 < rate <= 1 (anything else falls back to the default).
# Sellers list aspirationally, so an uncorrected median is biased high and produces
# false FLIPs. NOTE: 0.8 is a founder judgment call, NOT a measured figure — it is
# expected to be replaced once real user-reported sale outcomes exist to calibrate against.
VALUATION_REALIZATION_RATE=0.8

# Flat shipping estimate in cents until weight/category estimation lands
SHIPPING_FLAT_CENTS=500
# How long a computed valuation is served from cache
VALUATION_CACHE_TTL_HOURS=24
# Per-client (IP) daily lookup cap
LOOKUP_DAILY_CAP=50

PORT=3000
